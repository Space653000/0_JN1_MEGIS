{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://megis.local/schemas/manifest-corpus.schema.json",
  "title": "MEGIS Manifest Verification Corpus",
  "description": "Table-driven corpus for G5-PKG-001: artifact kinds, tamper/delta mutations and expected verification outcomes.",
  "type": "object",
  "required": ["schemaVersion", "workItem", "corpus_id", "cases"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "workItem": { "const": "G5-PKG-001" },
    "corpus_id": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 16,
      "items": {
        "type": "object",
        "required": ["case_id", "artifact_kinds", "tamper", "dial", "expect"],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "artifact_kinds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["step", "stl_binary", "dxf", "json", "text"]
            }
          },
          "tamper": {
            "type": ["object", "null"],
            "properties": {
              "file": { "type": "string", "minLength": 1 },
              "mode": {
                "type": "string",
                "enum": ["flip_byte", "append_byte", "truncate"]
              }
            },
            "required": ["file", "mode"],
            "additionalProperties": false
          },
          "dial": {
            "type": ["object", "null"],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "drop_manifest_field",
                  "set_manifest_field",
                  "set_maturity_state",
                  "set_package_kind",
                  "released_maturity",
                  "production_ready_note",
                  "unregistered_fingerprint_policy",
                  "drop_artifact_entry",
                  "rename_artifact_file"
                ]
              },
              "field": { "type": "string" },
              "value": {}
            },
            "required": ["action"],
            "additionalProperties": false
          },
          "expect": {
            "type": "object",
            "required": ["valid", "error_code"],
            "properties": {
              "valid": { "type": "boolean" },
              "error_code": {
                "type": ["string", "null"],
                "enum": [null, "MEGIS-PKG-001", "MEGIS-PKG-002"]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
