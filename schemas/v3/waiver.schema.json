{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://megis.local/schemas/v3/waiver.schema.json",
  "title": "MEGIS Rule Waiver (v3)",
  "description": "A named, scoped exemption for a specific rule failure with mandatory expiry conditions. Waivers live in execution/signoffs/WV-<NNNN>.yaml and become invalid automatically when an input or rule version changes or an absolute date passes.",
  "type": "object",
  "required": [
    "waiver_id",
    "rule_id",
    "rule_version",
    "design_id",
    "revision",
    "entity_refs",
    "reason",
    "risk_accepted",
    "owner",
    "approved_by_signoff",
    "expires_when",
    "affected_artifacts",
    "revalidation_required"
  ],
  "properties": {
    "waiver_id": { "type": "string", "pattern": "^WV-[0-9]{4}$" },
    "rule_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
    "rule_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "design_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "entity_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "reason": { "type": "string", "minLength": 1 },
    "risk_accepted": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "approved_by_signoff": { "type": "string", "pattern": "^SO-[0-9]{4}$" },
    "expires_when": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "const": "input_changed" },
          { "const": "rule_version_changed" },
          {
            "type": "object",
            "required": ["date"],
            "properties": { "date": { "type": "string", "format": "date" } },
            "additionalProperties": false
          }
        ]
      }
    },
    "affected_artifacts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "revalidation_required": { "type": "boolean" }
  },
  "additionalProperties": false
}
