{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://megis.local/schemas/v3/grounded-explanation.schema.json",
  "title": "MEGIS Grounded Explanation",
  "type": "object",
  "required": ["schemaVersion", "locale", "sourceFingerprints", "paragraphs"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "locale": { "const": "zh-TW" },
    "sourceFingerprints": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Za-z0-9._:-]+$" },
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "numericCitations"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "numericCitations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["token", "sourceId", "jsonPointer"],
              "properties": {
                "token": { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" },
                "sourceId": { "type": "string", "minLength": 1 },
                "jsonPointer": { "type": "string", "pattern": "^(?:/(?:[^~/]|~[01])*)+$" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
