  "cases": [
    {
      "case_id": "imp-step-mm-valid",
      "name": "metric STEP box extracts provable metadata",
      "input": {
        "format": "STEP",
        "sample": { "kind": "valid" }
      },
      "expect": {
        "valid": true,
        "boundingBoxMm": {
          "xmin": 0.0,
          "ymin": 0.0,
          "zmin": 0.0,
          "xmax": 10.0,
          "ymax": 20.0,
          "zmax": 30.0
        },
        "solids": 1,
        "shells": 1,
        "edges": 1,
        "candidateHoles": 1,
        "candidatePlanarSections": 1,
        "fileUnit": "millimetre"
      }
    },
    {
      "case_id": "imp-step-inch-valid",
      "name": "imperial STEP reports inch unit",
      "input": {
        "format": "STEP",
        "sample": { "kind": "valid" }
      },
      "expect": {
        "valid": true,
        "solids": 1,
        "candidateHoles": 1,
        "fileUnit": "inch"
      }
    },
