{
  "schemaVersion": "1.0.0",
  "workItem": "G3-VAL-002",
  "pack_id": "cnc-dfm-rulepack@1.0.0",
  "title": "CNC DFM 第一批規則（Reference Fixture）",
  "rules": [
    {
      "rule_id": "CNC_MIN_WALL_001",
      "version": "1.0.0",
      "status": "in_review",
      "source": "SRC-CNC-DFM-001",
      "source_revision": "2026-A",
      "source_clause": "design guidance: minimum wall thickness",
      "owner": "mechanical_engineering",
      "reviewed_by": null,
      "scope": {
        "domain": "cnc",
        "component_types": ["enclosure"]
      },
      "condition": {
        "type": "gte",
        "field": "wall_thickness_mm",
        "limit_mm": 0.8
      },
      "severity": "error",
      "recommendation": "increase minimum wall thickness to >= 0.8 mm",
      "auto_fix": false,
      "effective_date": "2026-09-22",
      "applicability": {
        "envelope_ref": "envelope.cnc_enclosure@1.0.0",
        "materials": ["AL6061-T6"],
        "processes": ["cnc_3axis"]
      },
      "waiver_category": "standard",
      "waiver_policy": {
        "waivable": true,
        "requires_signoff": true,
        "revalidation_required": true
      },
      "tests": {
        "positive": [
          {
            "name": "wall_1.5_mm_sufficient",
            "inputs": {"wall_thickness_mm": 1.5},
            "expect": "pass"
          }
        ],
        "negative": [
          {
            "name": "thin_wall_0.5_mm",
            "inputs": {"wall_thickness_mm": 0.5},
            "expect": "fail"
          }
        ],
        "boundary": [
          {
            "name": "wall_at_lower_limit",
            "inputs": {"wall_thickness_mm": 0.8},
            "expect": "pass"
          }
        ]
      }
    },
    {
      "rule_id": "CNC_TAP_BLIND_001",
      "version": "1.0.0",
      "status": "in_review",
      "source": "SRC-CNC-DFM-001",
      "source_revision": "2026-A",
      "source_clause": "design guidance: blind tapped hole drill depth",
      "owner": "mechanical_engineering",
      "reviewed_by": null,
      "scope": {
        "domain": "cnc",
        "component_types": ["enclosure"]
      },
      "condition": {
        "type": "ratio_gte",
        "numerator": "drill_depth_mm",
        "denominator": "required_thread_plus_allowance_mm",
        "limit": 1.0
      },
      "severity": "error",
      "recommendation": "increase blind hole drill depth beyond thread length plus allowance",
      "auto_fix": false,
      "effective_date": "2026-09-22",
      "applicability": {
        "envelope_ref": "envelope.cnc_enclosure@1.0.0",
        "materials": ["AL6061-T6"],
        "processes": ["cnc_3axis"]
      },
      "waiver_category": "standard",
      "waiver_policy": {
        "waivable": true,
        "requires_signoff": true,
        "revalidation_required": true
      },
      "tests": {
        "positive": [
          {
            "name": "drill_depth_above_required",
            "inputs": {"drill_depth_mm": 12.0, "required_thread_plus_allowance_mm": 10.0},
            "expect": "pass"
          }
        ],
        "negative": [
          {
            "name": "drill_depth_below_required",
            "inputs": {"drill_depth_mm": 9.0, "required_thread_plus_allowance_mm": 10.0},
            "expect": "fail"
          }
        ],
        "boundary": [
          {
            "name": "drill_depth_at_required",
            "inputs": {"drill_depth_mm": 10.0, "required_thread_plus_allowance_mm": 10.0},
            "expect": "pass"
          }
        ]
      }
    },
    {
      "rule_id": "CNC_HOLE_ASPECT_001",
      "version": "1.0.0",
      "status": "in_review",
      "source": "SRC-CNC-DFM-001",
      "source_revision": "2026-A",
      "source_clause": "design guidance: hole depth to diameter aspect ratio",
      "owner": "mechanical_engineering",
      "reviewed_by": null,
      "scope": {
        "domain": "cnc",
        "component_types": ["enclosure"]
      },
      "condition": {
        "type": "ratio_lte",
        "numerator": "hole_depth_mm",
        "denominator": "hole_diameter_mm",
        "limit": 3.0
      },
      "severity": "error",
      "recommendation": "reduce hole depth or increase diameter so aspect ratio stays within 3",
      "auto_fix": false,
      "effective_date": "2026-09-22",
      "applicability": {
        "envelope_ref": "envelope.cnc_enclosure@1.0.0",
        "materials": ["AL6061-T6"],
        "processes": ["cnc_3axis"]
      },
      "waiver_category": "standard",
      "waiver_policy": {
        "waivable": true,
        "requires_signoff": true,
        "revalidation_required": true
      },
      "tests": {
        "positive": [
          {
            "name": "aspect_2_sufficient",
            "inputs": {"hole_depth_mm": 12.0, "hole_diameter_mm": 6.0},
            "expect": "pass"
          }
        ],
        "negative": [
          {
            "name": "deep_hole_aspect_3_5",
            "inputs": {"hole_depth_mm": 21.0, "hole_diameter_mm": 6.0},
            "expect": "fail"
          }
        ],
        "boundary": [
          {
            "name": "aspect_at_limit",
            "inputs": {"hole_depth_mm": 18.0, "hole_diameter_mm": 6.0},
            "expect": "pass"
          }
        ]
      }
    },
    {
      "rule_id": "CNC_INT_RADIUS_001",
      "version": "1.0.0",
      "status": "in_review",
      "source": "SRC-CNC-DFM-001",
      "source_revision": "2026-A",
      "source_clause": "design guidance: internal corner radius versus tool radius",
      "owner": "mechanical_engineering",
      "reviewed_by": null,
      "scope": {
        "domain": "cnc",
        "component_types": ["enclosure"]
      },
      "condition": {
        "type": "ratio_gte",
        "numerator": "internal_radius_mm",
        "denominator": "tool_radius_mm",
        "limit": 1.2
      },
      "severity": "error",
      "recommendation": "increase internal corner radius above tool radius plus margin",
      "auto_fix": false,
      "effective_date": "2026-09-22",
      "applicability": {
        "envelope_ref": "envelope.cnc_enclosure@1.0.0",
        "materials": ["AL6061-T6"],
        "processes": ["cnc_3axis"]
      },
      "waiver_category": "standard",
      "waiver_policy": {
        "waivable": true,
        "requires_signoff": true,
        "revalidation_required": true
      },
      "tests": {
        "positive": [
          {
            "name": "radius_with_margin",
            "inputs": {"internal_radius_mm": 1.8, "tool_radius_mm": 1.0},
            "expect": "pass"
          }
        ],
        "negative": [
          {
            "name": "radius_without_margin",
            "inputs": {"internal_radius_mm": 1.0, "tool_radius_mm": 1.0},
            "expect": "fail"
          }
        ],
        "boundary": [
          {
            "name": "radius_at_limit",
            "inputs": {"internal_radius_mm": 1.2, "tool_radius_mm": 1.0},
            "expect": "pass"
          }
        ]
      }
    },
    {
      "rule_id": "CNC_DEPTH_RATIO_001",
      "version": "1.0.0",
      "status": "in_review",
      "source": "SRC-CNC-DFM-001",
      "source_revision": "2026-A",
      "source_clause": "design guidance: pocket depth to tool diameter ratio",
      "owner": "mechanical_engineering",
      "reviewed_by": null,
      "scope": {
        "domain": "cnc",
        "component_types": ["enclosure"]
      },
      "condition": {
        "type": "ratio_lte",
        "numerator": "pocket_depth_mm",
        "denominator": "tool_diameter_mm",
        "limit": 4.0
      },
      "severity": "warning",
      "recommendation": "reduce pocket depth below 4 times tool diameter or use a larger tool",
      "auto_fix": false,
      "effective_date": "2026-09-22",
      "applicability": {
        "envelope_ref": "envelope.cnc_enclosure@1.0.0",
        "materials": ["AL6061-T6"],
        "processes": ["cnc_3axis"]
      },
      "waiver_category": "standard",
      "waiver_policy": {
        "waivable": true,
        "requires_signoff": false,
        "revalidation_required": true
      },
      "tests": {
        "positive": [
          {
            "name": "shallow_pocket",
            "inputs": {"pocket_depth_mm": 20.0, "tool_diameter_mm": 10.0},
            "expect": "pass"
          }
        ],
        "negative": [
          {
            "name": "deep_pocket_5x",
            "inputs": {"pocket_depth_mm": 50.0, "tool_diameter_mm": 10.0},
            "expect": "fail"
          }
        ],
        "boundary": [
          {
            "name": "pocket_at_4x",
            "inputs": {"pocket_depth_mm": 40.0, "tool_diameter_mm": 10.0},
            "expect": "pass"
          }
        ]
      }
    },
    {
      "rule_id": "CNC_TOOL_ACCESS_001",
      "version": "1.0.0",
      "status": "in_review",
      "source": "SRC-CNC-DFM-001",
      "source_revision": "2026-A",
      "source_clause": "design guidance: tool access opening",
      "owner": "mechanical_engineering",
      "reviewed_by": null,
      "scope": {
        "domain": "cnc",
        "component_types": ["enclosure"]
      },
      "condition": {
        "type": "ratio_gte",
        "numerator": "access_opening_mm",
        "denominator": "tool_diameter_mm",
        "limit": 1.1
      },
      "severity": "error",
      "recommendation": "widen tool access opening beyond tool diameter plus clearance",
      "auto_fix": false,
      "effective_date": "2026-09-22",
      "applicability": {
        "envelope_ref": "envelope.cnc_enclosure@1.0.0",
        "materials": ["AL6061-T6"],
        "processes": ["cnc_3axis"]
      },
      "waiver_category": "standard",
      "waiver_policy": {
        "waivable": true,
        "requires_signoff": true,
        "revalidation_required": true
      },
      "tests": {
        "positive": [
          {
            "name": "clear_tool_access",
            "inputs": {"access_opening_mm": 26.0, "tool_diameter_mm": 20.0},
            "expect": "pass"
          }
        ],
        "negative": [
          {
            "name": "opening_equals_tool",
            "inputs": {"access_opening_mm": 20.0, "tool_diameter_mm": 20.0},
            "expect": "fail"
          }
        ],
        "boundary": [
          {
            "name": "opening_at_limit",
            "inputs": {"access_opening_mm": 22.0, "tool_diameter_mm": 20.0},
            "expect": "pass"
          }
        ]
      }
    },
    {
      "rule_id": "CNC_SETUP_COUNT_001",
      "version": "1.0.0",
      "status": "in_review",
