      "effective_date": "2026-09-22",
      "applicability": {
        "envelope_ref": "envelope.cnc_enclosure@1.0.0",
        "materials": ["AL6061-T6"],
        "processes": ["cnc_3axis"]
      },
      "waiver_category": "standard",
      "waiver_policy": {
        "waivable": true,
        "requires_signoff": true,
        "revalidation_required": true
      },
      "tests": {
        "positive": [
          {
            "name": "two_setups",
            "inputs": {"setup_count": 2},
            "expect": "pass"
          }
        ],
        "negative": [
          {
            "name": "four_setups",
            "inputs": {"setup_count": 4},
            "expect": "fail"
          }
        ],
        "boundary": [
          {
            "name": "three_setups",
            "inputs": {"setup_count": 3},
            "expect": "pass"
          }
        ]
      }
    },
