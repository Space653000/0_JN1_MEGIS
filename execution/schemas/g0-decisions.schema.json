{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://megis.local/schemas/g0-decisions.schema.json",
  "title": "MEGIS G0 Decision Register",
  "type": "object",
  "required": ["schemaVersion", "workItem", "blueprintRef", "status", "recordedAt", "decisions"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "workItem": { "const": "V3C-DEC-001" },
    "blueprintRef": { "const": "v3.0 §8.1" },
    "status": { "const": "accepted" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "decisions": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "outcome",
          "basis",
          "adr",
          "evidence",
          "implementationStatus",
          "followUpWorkItems"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^D[1-9]$" },
          "title": { "type": "string", "minLength": 1 },
          "outcome": { "type": "string", "minLength": 1 },
          "basis": {
            "enum": [
              "user_decision",
              "blueprint_default_confirmed_by_existing_evidence",
              "existing_implementation_decision"
            ]
          },
          "adr": { "type": "string", "pattern": "^docs/decisions/ADR-[0-9]{4}-[a-z0-9-]+\\.md$" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "implementationStatus": {
            "enum": ["enforced", "partially_enforced", "policy_only"]
          },
          "followUpWorkItems": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)+$" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
